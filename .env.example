# Local testing defaults:
# EXPO_PUBLIC_SOCKET_URL=http://192.168.0.109:3030
# EXPO_PUBLIC_CUSTOMER_BASE_URL=http://192.168.0.109:3030
# EXPO_PUBLIC_OWNER_TOKEN=replace-with-a-private-owner-token
# VITE_CUSTOMER_BASE_URL=http://192.168.0.109:3030
# VITE_OWNER_TOKEN=replace-with-a-private-owner-token
# QUEUE_JUMPER_OWNER_TOKEN=replace-with-a-private-owner-token
# QUEUE_JUMPER_DATA_FILE=./data/queue-state.json
# DATABASE_URL=postgresql://user:password@localhost:5432/queuejumper
# REQUIRE_DATABASE=false
# NOTIFICATION_PROVIDER=mock
# JOIN_RATE_WINDOW_MS=60000
# JOIN_RATE_LIMIT=8
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production/domain example:
# NODE_ENV=production
# EXPO_PUBLIC_SOCKET_URL=https://queuejumper-production.up.railway.app
# EXPO_PUBLIC_CUSTOMER_BASE_URL=https://queuejumper-production.up.railway.app
# EXPO_PUBLIC_OWNER_TOKEN=replace-with-a-private-owner-token
# VITE_CUSTOMER_BASE_URL=https://queuejumper-production.up.railway.app
# VITE_OWNER_TOKEN=replace-with-a-private-owner-token
# QUEUE_JUMPER_OWNER_TOKEN=replace-with-a-private-owner-token
# DATABASE_URL=postgresql://user:password@host:5432/railway
# REQUIRE_DATABASE=true
# NOTIFICATION_PROVIDER=twilio-or-fcm
# JOIN_RATE_WINDOW_MS=60000
# JOIN_RATE_LIMIT=8
# ALLOWED_ORIGINS=https://queuejumper-production.up.railway.app
