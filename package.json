{
  "name": "queue-jumper",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "start": "concurrently \"node server/index.js\" \"expo start --lan --clear\"",
    "expo": "expo start --lan --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "vite:client": "vite --host 127.0.0.1",
    "vite:dev": "concurrently \"vite --host 127.0.0.1\" \"node server/index.js\"",
    "vite:build": "vite build",
    "vite:preview": "vite preview --host 127.0.0.1",
    "railway:start": "node server/index.js",
    "server": "node server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vite": "^7.0.0"
  }
}
